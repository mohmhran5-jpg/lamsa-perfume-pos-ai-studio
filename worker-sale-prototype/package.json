{
  "name": "worker-sale-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "emulator": "firebase emulators:start --project demo-worker-sale --only firestore --config firebase.json --non-interactive",
    "worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test:app-contract": "node --experimental-strip-types --test tests/lamsa-contract.test.mjs tests/firestore-path.test.mjs tests/production-firestore-auth.test.mjs tests/worker-runtime-policy.test.mjs tests/pricing-parity.test.mjs",
    "test:prototype": "npm run test:app-contract && node scripts/run-local-tests.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.28.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.0",
    "wrangler": "^4.45.0"
  }
}
