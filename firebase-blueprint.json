{
  "entities": {
    "Sale": {
      "title": "Sale",
      "description": "Perfume sale transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "items": { "type": "array" },
        "totalPrice": { "type": "number" },
        "totalCost": { "type": "number" },
        "totalProfit": { "type": "number" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "commissionAmount": { "type": "number" },
        "employeeName": { "type": "string" },
        "source": { "type": "string" },
        "isReversed": { "type": "boolean" },
        "dataClassification": { "type": "string" }
      },
      "required": ["id", "date", "items", "totalPrice", "totalCost", "totalProfit", "paymentMethod"]
    },
    "Product": {
      "title": "Product",
      "description": "Perfume product and stock in grams",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "origin": { "type": "string" },
        "gender": { "type": "string" },
        "season": { "type": "string" },
        "type": { "type": "string" },
        "stock_grams": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "brand", "type", "stock_grams"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Store operational and fixed expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "isRecurringMonthly": { "type": "boolean" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "amount", "category", "date"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store configuration and branding",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "currency": { "type": "string" },
        "storeSlogan": { "type": "string" },
        "activeThemeId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["storeName", "currency"]
    },
    "BottleSize": {
      "title": "BottleSize",
      "description": "Bottle size economics and pricing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sizeMl": { "type": "number" },
        "essenceGrams": { "type": "number" },
        "bottleCost": { "type": "number" },
        "normalPrice": { "type": "number" },
        "specialPrice": { "type": "number" },
        "officialCost": { "type": "number" }
      },
      "required": ["id", "sizeMl", "essenceGrams", "bottleCost"]
    },
    "FinancialVault": {
      "title": "FinancialVault",
      "description": "Segregated financial vaults for restocking, rent, salaries, and profit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currentBalance": { "type": "number" },
        "totalInflow": { "type": "number" },
        "totalWithdrawn": { "type": "number" }
      },
      "required": ["id", "name", "currentBalance"]
    },
    "WithdrawalTransaction": {
      "title": "WithdrawalTransaction",
      "description": "Audited cash disbursement and vault withdrawal records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vaultId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "executedBy": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "vaultId", "amount", "date", "executedBy", "reason"]
    },
    "StaffAttendanceRecord": {
      "title": "StaffAttendanceRecord",
      "description": "Staff attendance and shift opening records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "employeeName": { "type": "string" },
        "shiftOpenedAt": { "type": "string" },
        "isCompleted": { "type": "boolean" }
      },
      "required": ["id", "date", "employeeName", "shiftOpenedAt"]
    },
    "ProductionBatch": {
      "title": "ProductionBatch",
      "description": "Production and maceration batch records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productName": { "type": "string" },
        "creationDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "productName", "creationDate", "status"]
    },
    "AuditLogRecord": {
      "title": "AuditLogRecord",
      "description": "Audit trail records for system modifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "user": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "timestamp", "user", "action"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "System user account and permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "isActive": { "type": "boolean" },
        "permissions": { "type": "object" }
      },
      "required": ["id", "username", "role"]
    },
    "CustomCustomerRecord": {
      "title": "CustomCustomerRecord",
      "description": "Real store customer profile and loyalty balance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" },
        "bonusPoints": { "type": "number" },
        "redeemedPoints": { "type": "number" }
      },
      "required": ["name"]
    },
    "SavedMixFormula": {
      "title": "SavedMixFormula",
      "description": "Saved custom perfume mix formula",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bottleSizeMl": { "type": "number" },
        "components": { "type": "array" }
      },
      "required": ["id", "name", "bottleSizeMl", "components"]
    },
    "ConnectedDevice": {
      "title": "ConnectedDevice",
      "description": "Real-time presence of active terminals",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "userName": { "type": "string" },
        "lastSeen": { "type": "string" },
        "isOnline": { "type": "boolean" }
      },
      "required": ["deviceId", "userName", "lastSeen"]
    },
    "OwnerStaffBroadcast": {
      "title": "OwnerStaffBroadcast",
      "description": "Real-time owner broadcasts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message", "createdAt"]
    },
    "DailyClosure": {
      "title": "DailyClosure",
      "description": "Daily shift closure report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "openedBy": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "date", "status"]
    }
  },
  "firestore": {
    "/sales/{saleId}": { "schema": "Sale", "description": "Sales records" },
    "/products/{productId}": { "schema": "Product", "description": "Products" },
    "/expenses/{expenseId}": { "schema": "Expense", "description": "Expenses" },
    "/settings/store": { "schema": "StoreSettings", "description": "Settings" },
    "/bottleSizes/{bottleId}": { "schema": "BottleSize", "description": "Bottle sizes" },
    "/vaults/{vaultId}": { "schema": "FinancialVault", "description": "Vaults" },
    "/withdrawals/{withdrawalId}": { "schema": "WithdrawalTransaction", "description": "Withdrawals" },
    "/staff_attendance/{attendanceId}": { "schema": "StaffAttendanceRecord", "description": "Attendance" },
    "/production_batches/{batchId}": { "schema": "ProductionBatch", "description": "Production" },
    "/audit_logs/{logId}": { "schema": "AuditLogRecord", "description": "Audit trail" },
    "/app_users/{userId}": { "schema": "AppUser", "description": "Users" },
    "/customers/{customerId}": { "schema": "CustomCustomerRecord", "description": "Customers" },
    "/saved_mixes/{mixId}": { "schema": "SavedMixFormula", "description": "Mixes" },
    "/connected_devices/{deviceId}": { "schema": "ConnectedDevice", "description": "Devices" },
    "/owner_broadcasts/{broadcastId}": { "schema": "OwnerStaffBroadcast", "description": "Broadcasts" },
    "/daily_closures/{closureId}": { "schema": "DailyClosure", "description": "Closures" }
  }
}
