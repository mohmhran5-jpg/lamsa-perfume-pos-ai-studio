rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfume Sales
    match /sales/{saleId} {
      allow read, write: if true;
    }

    // Perfume Products & Stock
    match /products/{productId} {
      allow read, write: if true;
    }

    // Expenses & Fixed Costs
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // Store Settings & Branding
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Bottle Sizes & Margins
    match /bottleSizes/{bottleId} {
      allow read, write: if true;
    }

    // Financial Vaults (Restock, Rent, Salaries, Profit)
    match /vaults/{vaultId} {
      allow read, write: if true;
    }

    // Withdrawal Transactions & Cash Vouchers
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Staff Attendance & Shift Records
    match /staff_attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Production Batches
    match /production_batches/{batchId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // App Users & RBAC Permissions
    match /app_users/{userId} {
      allow read, write: if true;
    }

    // Daily Closures & Day Operations
    match /daily_closures/{closureId} {
      allow read, write: if true;
    }

    // Purchase Requests
    match /purchase_requests/{requestId} {
      allow read, write: if true;
    }

    // Customer Out-of-Stock Requests
    match /customer_requests/{requestId} {
      allow read, write: if true;
    }

    // Stock Taking & Inventory Checks
    match /stock_checks/{checkId} {
      allow read, write: if true;
    }

    // Strategic Replenishment Orders
    match /replenishment_orders/{orderId} {
      allow read, write: if true;
    }

    // Persistent Fragrance Database
    match /fragrance_database/{profileId} {
      allow read, write: if true;
    }

    // Real Customer & Loyalty CRM Profiles
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Saved Mix Formulas
    match /saved_mixes/{mixId} {
      allow read, write: if true;
    }

    // Real-Time Connected Devices Presence & Multi-Device Sync
    match /connected_devices/{deviceId} {
      allow read, write: if true;
    }

    // Diagnostics & Connection Check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Catch-all Default Deny for other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
