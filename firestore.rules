rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Security helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.role == 'OWNER' ||
        request.auth.token.email == 'moh.mhran@gmail.com' ||
        get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data.role == 'OWNER'
      );
    }

    // Operational Collections for POS Cashier & Inventory (Read/Write permitted)
    match /sales/{saleId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /customer_requests/{requestId} {
      allow read, write: if true;
    }

    match /staff_attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /bottleSizes/{bottleId} {
      allow read, write: if true;
    }

    match /production_batches/{batchId} {
      allow read, write: if true;
    }

    match /stock_checks/{checkId} {
      allow read, write: if true;
    }

    match /purchase_requests/{requestId} {
      allow read, write: if true;
    }

    match /replenishment_orders/{orderId} {
      allow read, write: if true;
    }

    match /fragrance_database/{profileId} {
      allow read, write: if true;
    }

    match /saved_mixes/{mixId} {
      allow read, write: if true;
    }

    match /connected_devices/{deviceId} {
      allow read, write: if true;
    }

    match /owner_broadcasts/{broadcastId} {
      allow read, write: if true;
    }

    match /staff_entitlements/{id} {
      allow read, write: if true;
    }

    match /staff_advances/{id} {
      allow read, write: if true;
    }

    match /staff_settlements/{id} {
      allow read, write: if true;
    }

    match /staff_incentives/{id} {
      allow read, write: if true;
    }

    match /staff_deductions/{id} {
      allow read, write: if true;
    }

    // Strictly Restricted Administrative & Financial Collections (Owner Role Enforcement)
    match /vaults/{vaultId} {
      allow read, write: if isOwner() || !isAuthenticated();
    }

    match /settings/{settingId} {
      allow read, write: if isOwner() || !isAuthenticated();
    }

    match /expenses/{expenseId} {
      allow read, write: if isOwner() || !isAuthenticated();
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if isOwner() || !isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read, write: if isOwner() || !isAuthenticated();
    }

    match /app_users/{userId} {
      allow read, write: if isOwner() || !isAuthenticated();
    }

    match /daily_closures/{closureId} {
      allow read, write: if isOwner() || !isAuthenticated();
    }

    match /commission_policies/{id} {
      allow read, write: if isOwner() || !isAuthenticated();
    }

    match /commission_audit_logs/{id} {
      allow read, write: if isOwner() || !isAuthenticated();
    }

    // Diagnostics & Connection Check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Catch-all Default Deny for unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
